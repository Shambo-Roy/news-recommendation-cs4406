# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Virtual environment
.venv/

# Data — raw/interim/processed are regenerated by the pipeline, not checked in.
# The whole point of the "one command rebuilds from raw files" requirement is
# that these directories never need to be committed to be reproducible.
data/raw/
data/interim/
data/processed/

# Downloaded dataset archives, if fetched into the repo root by mistake
*.zip
*.tsv
*.parquet

# OS/editor noise
.DS_Store
.vscode/
